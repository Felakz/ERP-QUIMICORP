// ============================================================================
// QUIMICORP PERU S.A.C. - ERP INDUSTRIAL
// schema.prisma - Modelo relacional completo (Sprints 1-5)
// PostgreSQL 16 (Supabase) + Prisma ORM
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../backend/node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnidadMedida {
  KG
  L
  GR
  ML
  UN
}

enum TipoInsumo {
  BASE
  FRAGANCIA
  PIGMENTO
  ENVASE
  OTRO
}

enum EstadoGenerico {
  ACTIVO
  INACTIVO
}

enum EstadoFormula {
  ACTIVA
  INACTIVA
  EN_REVISION
}

enum EstadoOrdenProduccion {
  PENDIENTE
  EN_PROCESO
  QA_PENDIENTE
  APROBADO
  EN_ETIQUETADO
  ETIQUETADO
  RECHAZADO
  DESPACHADO
}

enum TipoMovimientoKardex {
  ENTRADA
  SALIDA
  AJUSTE_FINO
  MERMA
  REAPROVECHAMIENTO
}

enum CategoriaKardex {
  PRODUCTO_TERMINADO
  MATERIA_PRIMA
  INSUMO
  ENVASE
  EMBALAJE
}

enum TipoMovimiento {
  ENTRADA_COMPRA
  ENTRADA_PRODUCCION
  ENTRADA_AJUSTE
  SALIDA_VENTA
  SALIDA_CONSUMO_PRODUCCION
  SALIDA_MERMA
}

enum EstadoSubAlmacen {
  DISPONIBLE
  REUSADO
  DESCARTADO
}

enum TipoMarcacion {
  ENTRADA
  SALIDA_ALMUERZO
  RETORNO_ALMUERZO
  SALIDA
}

enum EstadoAsistencia {
  PUNTUAL
  TARDANZA
  FALTA
  JUSTIFICADO
}

enum TipoEtiqueta {
  INSUMO
  GALON
  BARRIL
  FRASCO
}

enum EstadoDespacho {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  DEVUELTO
}

enum AccionPermiso {
  CREATE
  READ
  UPDATE
  DELETE
}

enum Role {
  GERENCIA
  ADMINISTRACION
  GERENTE_ADMINISTRATIVO
  ASISTENTE_ADMINISTRATIVO
  FINANZAS
  VENTAS_ATENCION_DIGITAL
  ECOMMERCE_MARKETING
  PRODUCCION_ALMACEN
  COMPRAS_PROVEEDORES
  RECURSOS_HUMANOS
  SISTEMAS_TI
  DISENO_MULTIMEDIA
  ARCHIVO_HISTORICO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nombre    String
  password  String
  role      Role     @default(PRODUCCION_ALMACEN)
  rolId     String?
  rol       Rol?     @relation("UserRol", fields: [rolId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SolicitudAutorizacion {
  id                String   @id @default(uuid())
  solicitanteId     String   @map("solicitante_id")
  solicitanteEmail  String   @map("solicitante_email")
  solicitanteNombre String   @map("solicitante_nombre")
  
  modulo            String
  accion            String   // 'FORMULA_EDIT', 'FORMULA_CLONE', 'CLIENTE_EDIT', 'CLIENTE_DELETE'
  recursoId         String?  @map("recurso_id")
  recursoNombre     String?  @map("recurso_nombre")
  motivo            String?
  estado            String   @default("PENDIENTE") // PENDIENTE, APROBADO, RECHAZADO
  
  aprobadorEmail    String?  @map("aprobador_email")
  respuestaMotivo   String?  @map("respuesta_motivo")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("solicitudes_autorizacion")
}

// ============================================================================
// 🟢 MODULO 1: PRODUCCION, FORMULAS E INVENTARIO (SPRINT 1)
// ============================================================================

model FamiliaInsumo {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  insumos     Insumo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("familias_insumo")
}

model Insumo {
  id            String         @id @default(uuid())
  codigo        String         @unique
  nombre        String
  familiaId     String
  familia       FamiliaInsumo  @relation(fields: [familiaId], references: [id])
  unidadMedida       UnidadMedida
  unidadMedidaVisual String?
  categoria          String?
  proveedorHistorico String?
  stockTeorico       Decimal        @default(0) @db.Decimal(14, 4)
  stockReal          Decimal        @default(0) @db.Decimal(14, 4)
  stockMinimo        Decimal        @default(0) @db.Decimal(14, 4)
  costoUnitario      Decimal        @default(0) @db.Decimal(14, 4)
  estado             EstadoGenerico @default(ACTIVO)
  tipo               TipoInsumo?    @default(OTRO)
  estadoFisico       String?        @map("estado_fisico")

  formulaDetalles     FormulaDetalle[]
  ajustesFinos        AjusteFino[]
  kardexMovimientos   KardexInmutable[]
  kardexCategorizados KardexMovimiento[]
  subAlmacenSobrantes SubAlmacenSobrante[]
  pedidoAditivos      PedidoAditivo[]
  cotizaciones        CotizacionProveedor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familiaId])
  @@index([estado])
  @@index([tipo])
  @@map("insumos")
}

model FormulaMaster {
  id              String        @id @default(uuid())
  codigoFormula   String        @unique
  nombreProducto  String
  version         Int           @default(1)
  densidadTeorica Decimal       @db.Decimal(10, 4)
  estado          EstadoFormula @default(EN_REVISION)
  pasosElaboracion Json?        @map("pasos_elaboracion")

  detalles          FormulaDetalle[]
  ordenesProduccion OrdenProduccion[]
  pedidosComerciales PedidoComercial[]
  variants          FormulaVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@map("formulas_master")
}

model FormulaDetalle {
  id               String        @id @default(uuid())
  formulaId        String
  formula          FormulaMaster @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  insumoId         String?
  insumo           Insumo?       @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  nombreComponente String?
  skuComponente    String?
  porcentaje       Decimal       @db.Decimal(6, 3)
  pesoMasaTeorico  Decimal       @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formulaId])
  @@index([insumoId])
  @@map("formula_detalles")
}

model OrdenProduccion {
  id                  String                @id @default(uuid())
  codigoLote          String                @unique
  clienteNombre       String?               @default("Cliente Quimicorp SAC")
  operariosAsignados  String?
  colorEspecificado   String?
  fraganciaEspecificada String?
  prioridad           String?               @default("NORMAL")
  observacionesQA     String?
  motivoRechazo       String?
  pasoProceso         String?               @default("PENDIENTE_ASIGNACION")
  formulaId           String
  formula             FormulaMaster         @relation(fields: [formulaId], references: [id])
  cantidadPlanificada Decimal               @db.Decimal(14, 4)
  cantidadObtenida    Decimal?              @db.Decimal(14, 4)
  mermaCalculada      Decimal?              @db.Decimal(14, 4)
  estado              EstadoOrdenProduccion @default(PENDIENTE)
  supervisorId        String
  supervisor          Usuario               @relation("SupervisorOrdenes", fields: [supervisorId], references: [id])
  fechaCierre         DateTime?

  pedidoComercialId  String?        @map("pedido_comercial_id")
  pedidoComercial    PedidoComercial? @relation(fields: [pedidoComercialId], references: [id])

  ajustesFinos     AjusteFino[]
  subAlmacenOrigen SubAlmacenSobrante[]
  etiquetas        EtiquetaImpresa[]
  ticketsDespacho  TicketDespacho[]
  incidencias      IncidenciaLote[]
  calificaciones   CalificacionOperario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([formulaId])
  @@map("ordenes_produccion")
}

model AjusteFino {
  id                String          @id @default(uuid())
  ordenProduccionId String
  ordenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [id])
  insumoId          String
  insumo            Insumo          @relation(fields: [insumoId], references: [id])
  cantidadAgregada  Decimal         @db.Decimal(14, 4)
  observacion       String?
  registradoPorId   String
  registradoPor     Usuario         @relation("RegistroAjustesFinos", fields: [registradoPorId], references: [id])
  timestamp         DateTime        @default(now())

  @@index([ordenProduccionId])
  @@map("ajustes_finos")
}

model SubAlmacenSobrante {
  id                  String           @id @default(uuid())
  loteOrigenId        String
  loteOrigen          OrdenProduccion  @relation(fields: [loteOrigenId], references: [id])
  insumoSubproductoId String
  insumoSubproducto   Insumo           @relation(fields: [insumoSubproductoId], references: [id])
  pesoDisponible      Decimal          @db.Decimal(14, 4)
  ubicacion           String
  estado              EstadoSubAlmacen @default(DISPONIBLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@map("sub_almacen_sobrantes")
}

// KardexInmutable: registro append-only, sin updatedAt (inmutable por diseño)
model KardexInmutable {
  id                  String               @id @default(uuid())
  insumoId            String
  insumo              Insumo               @relation(fields: [insumoId], references: [id])
  tipoMovimiento      TipoMovimientoKardex
  cantidad            Decimal              @db.Decimal(14, 4)
  stockAnterior       Decimal              @db.Decimal(14, 4)
  stockNuevo          Decimal              @db.Decimal(14, 4)
  documentoReferencia String?
  usuarioId           String
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  createdAt           DateTime             @default(now()) // sello de tiempo inalterable

  @@index([insumoId])
  @@index([tipoMovimiento])
  @@index([createdAt])
  @@map("kardex_inmutable")
}

model KardexMovimiento {
  id               String          @id @default(uuid())
  categoriaKardex  CategoriaKardex @map("categoria_kardex")
  productoNombre   String          @map("producto_nombre")
  familia          String?
  categoriaNombre  String?         @map("categoria_nombre")
  proveedorCliente String?         @map("proveedor_cliente")
  unidadMedida     String          @map("unidad_medida")

  fecha   DateTime @default(now())
  tipoDoc String?  @map("tipo_doc")
  serie   String?
  numero  String?
  otp     String?

  tipoOperacion   TipoMovimiento @map("tipo_operacion")
  cantidadEntrada Float          @default(0) @map("cantidad_entrada")
  cantidadSalida  Float          @default(0) @map("cantidad_salida")
  saldoFinal      Float          @map("saldo_final")

  costoUnitario   Float?         @default(0) @map("costo_unitario")
  montoEntradaPen Float?         @default(0) @map("monto_entrada_pen")
  montoSalidaPen  Float?         @default(0) @map("monto_salida_pen")
  montoSaldoPen   Float?         @default(0) @map("monto_saldo_pen")

  insumoId  String?  @map("insumo_id")
  insumo    Insumo?  @relation(fields: [insumoId], references: [id])
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  sedeId    String?  @default("SEDE-LIMA") @map("sede_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([categoriaKardex])
  @@index([productoNombre])
  @@index([fecha])
  @@map("kardex_movimientos")
}

// ============================================================================
// 🔵 MODULO 2: PERSONAL, BIOMETRICO Y ASISTENCIA (SPRINT 2)
// ============================================================================

model Rol {
  id        String       @id @default(uuid())
  nombre    String       @unique
  permisos  RolPermiso[]
  usuarios  Usuario[]
  usersUser User[]       @relation("UserRol")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Usuario {
  id               String         @id @default(uuid())
  dni              String         @unique
  nombres          String
  apellidos        String
  cargo            String?
  rolId            String
  rol              Rol            @relation(fields: [rolId], references: [id])
  passwordHash     String
  codigoBiometrico String?        @unique
  estado           EstadoGenerico @default(ACTIVO)

  sucursalId String?  @map("sucursal_id")
  sucursal   Sucursal? @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  turnoId    String?  @map("turno_id")
  turno      Turno?   @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  ordenesSupervisadas     OrdenProduccion[]      @relation("SupervisorOrdenes")
  ajustesFinosRegistrados AjusteFino[]           @relation("RegistroAjustesFinos")
  kardexMovimientos       KardexInmutable[]
  marcaciones             MarcacionBiometrico[]
  asistencias             Asistencia[]
  calificaciones          CalificacionOperario[]
  etiquetasImpresas       EtiquetaImpresa[]
  incidenciasReportadas   IncidenciaLote[]
  auditLogs               AuditLog[]
  ventanasAprobadasQA     VentanaAlmuerzoQA[]
  kardexCategorizados     KardexMovimiento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rolId])
  @@index([sucursalId])
  @@index([turnoId])
  @@map("usuarios")
}

model MarcacionBiometrico {
  id            String        @id @default(uuid())
  usuarioId     String
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  tipoMarcacion TipoMarcacion
  timestamp     DateTime      @default(now())
  dispositivoId String

  @@index([usuarioId, timestamp])
  @@map("marcaciones_biometrico")
}

model Asistencia {
  id               String           @id @default(uuid())
  usuarioId        String
  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  fecha            DateTime         @db.Date
  horasTrabajadas  Decimal          @db.Decimal(5, 2)
  minutosTardanza  Int              @default(0)
  estadoAsistencia EstadoAsistencia @default(PUNTUAL)

  turnoId       String? @map("turno_id")
  turno         Turno?  @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  horaEntrada   String? @map("hora_entrada") // HH:mm
  horaSalida    String? @map("hora_salida")  // HH:mm
  estadoAlmuerzo String @default("PENDIENTE") @map("estado_almuerzo") // PENDIENTE, EN_ALMUERZO, OBLIGADO_ALMORZAR, COMPLETO, EXCEDIDO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, fecha])
  @@index([fecha])
  @@index([turnoId])
  @@map("asistencias")
}

model Sucursal {
  id            String   @id @default(uuid())
  nombre        String   @unique
  direccion     String?
  dispositivoId String?  @unique @map("dispositivo_id") // serial del huellero ZKTeco
  ip            String?  @map("ip")                    // IP fija LAN del huellero
  port          Int      @default(4370)

  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sucursales")
}

model Turno {
  id               String   @id @default(uuid())
  nombre           String   @unique
  horaInicio       String   @map("hora_inicio")    // HH:mm
  horaFin          String   @map("hora_fin")       // HH:mm
  toleranciaMinutos Int     @default(15) @map("tolerancia_minutos")
  almuerzoTope     String   @default("14:00") @map("almuerzo_tope") // HH:mm — pasada esta hora se obliga a comer

  usuarios    Usuario[]
  asistencias Asistencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("turnos")
}

// Marcaciones que llegan del huellero con un codigoBiometrico aún no vinculado a ningún Usuario.
// Nunca se inventa un empleado: gerencia los asigna desde la cola.
model MarcacionPendiente {
  id               String   @id @default(uuid())
  dispositivoId    String   @map("dispositivo_id")
  codigoBiometrico String   @map("codigo_biometrico")
  tipoMarcacion    String   @map("tipo_marcacion") // ENTRADA, SALIDA_ALMUERZO, RETORNO_ALMUERZO, SALIDA
  timestamp        DateTime @default(now())
  procesada        Boolean  @default(false)

  vinculadoAId String? @map("vinculado_a_id") // Usuario.id cuando se vincula/manual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([procesada])
  @@index([dispositivoId, timestamp])
  @@map("marcaciones_pendientes")
}

model VentanaAlmuerzoQA {
  id                      String   @id @default(uuid())
  fecha                   DateTime @db.Date
  horaInicioAprobada      DateTime
  horaFinMinima           DateTime
  aprobadoPorQAId         String
  aprobadoPorQA           Usuario  @relation(fields: [aprobadoPorQAId], references: [id])
  operariosHabilitadosIds String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ventanas_almuerzo_qa")
}

model CalificacionOperario {
  id                String          @id @default(uuid())
  usuarioId         String
  usuario           Usuario         @relation(fields: [usuarioId], references: [id])
  ordenProduccionId String
  ordenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [id])
  puntajeEficiencia Decimal         @db.Decimal(5, 2)
  comentarios       String?

  createdAt DateTime @default(now())

  @@map("calificaciones_operario")
}

// ============================================================================
// 🟡 MODULO 3: TRAZABILIDAD, ETIQUETADO Y DESPACHO (SPRINT 3)
// ============================================================================

model EtiquetaImpresa {
  id               String          @id @default(uuid())
  codigoEtiqueta   String          @unique
  loteProduccionId String
  loteProduccion   OrdenProduccion @relation(fields: [loteProduccionId], references: [id])
  tipoEtiqueta     TipoEtiqueta
  impresoPorId     String
  impresoPor       Usuario         @relation(fields: [impresoPorId], references: [id])
  timestamp        DateTime        @default(now())

  @@index([loteProduccionId])
  @@map("etiquetas_impresas")
}

model TicketDespacho {
  id                String          @id @default(uuid())
  codigoTicket      String          @unique
  ordenProduccionId String
  ordenProduccion   OrdenProduccion @relation(fields: [ordenProduccionId], references: [id])
  clienteDestino    String
  cantidadCajas     Int
  estadoDespacho    EstadoDespacho  @default(PENDIENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets_despacho")
}

model ColaDespacho {
  id               String   @id @default(uuid())
  loteCodigo       String   @map("lote_codigo")
  productoNombre   String   @map("producto_nombre")
  clienteNombre    String   @map("cliente_nombre")
  cantidad         String
  fechaFabricacion DateTime @default(now()) @map("fecha_fabricacion")
  codigoQR         String   @map("codigo_qr")
  codigoBarras     String   @map("codigo_barras")
  estado           String   @default("LISTO_PARA_IMPRIMIR")
  numeroGuia       String?  @map("numero_guia")

  ruc              String?  @map("ruc")
  sku              String?
  advertenciaGHS   String?  @map("advertencia_ghs")
  codigoGHS        String?  @map("codigo_ghs")
  tipoPeligro      String?  @map("tipo_peligro")
  tipoEnvase       String?  @map("tipo_envase")
  taraGramos       Int?     @map("tara_gramos")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([loteCodigo])
  @@index([estado])
  @@map("cola_despacho")
}

model IncidenciaLote {
  id               String          @id @default(uuid())
  loteProduccionId String
  loteProduccion   OrdenProduccion @relation(fields: [loteProduccionId], references: [id])
  reportadoPorId   String
  reportadoPor     Usuario         @relation(fields: [reportadoPorId], references: [id])
  tipoIncidencia   String
  descripcion      String
  impactoMerma     Decimal?        @db.Decimal(14, 4)

  createdAt DateTime @default(now())

  @@map("incidencias_lote")
}

// ============================================================================
// 🔴 MODULO 4: ANALYTICS, KPIs Y GERENCIA (SPRINT 4)
// ============================================================================

model MetricaProduccionDiaria {
  id                 String   @id @default(uuid())
  fecha              DateTime @unique @db.Date
  volumenTotalLitros Decimal  @db.Decimal(14, 4)
  mermaTotalKg       Decimal  @db.Decimal(14, 4)
  eficienciaPromedio Decimal  @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@map("metricas_produccion_diaria")
}

model ValorizacionInventario {
  id                          String   @id @default(uuid())
  fechaCierre                 DateTime @unique @db.Date
  materiaPrimaValorizada      Decimal  @db.Decimal(16, 4)
  productoTerminadoValorizado Decimal  @db.Decimal(16, 4)

  createdAt DateTime @default(now())

  @@map("valorizacion_inventario")
}

// ============================================================================
// 🟣 MODULO 5: SEGURIDAD ENTERPRISE Y AUDIT LOGS (SPRINT 5)
// ============================================================================

model Permiso {
  id     String        @id @default(uuid())
  modulo String
  accion AccionPermiso
  roles  RolPermiso[]

  @@unique([modulo, accion])
  @@map("permisos")
}

model RolPermiso {
  rolId     String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permisoId String
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model AuditLog {
  id              String   @id @default(uuid())
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  accion          String
  tablaAfectada   String
  registroId      String
  datosAnteriores Json?
  datosNuevos     Json?
  ipOrigen        String?
  timestamp       DateTime @default(now())

  @@index([tablaAfectada, registroId])
  @@index([usuarioId])
  @@map("audit_logs")
}

// ============================================================================
// 📦 MODULO PEDIDOS COMERCIALES ADMINISTRACIÓN (SPRINT 6)
// ============================================================================

enum EstadoPedidoComercial {
  NUEVO
  PENDIENTE_REVISION
  VALIDANDO
  APROBADO
  EN_PRODUCCION
  DEVUELTO
  RECHAZADO
  ENTREGADO
}

enum PrioridadPedidoComercial {
  URGENTE
  NORMAL
  PROGRAMADO
}

model PedidoComercial {
  id                 String                   @id @default(uuid())
  codigoOrden        String                   @unique @map("codigo_orden")
  codigoRefAdmin     String?                  @map("codigo_ref_admin")
  clienteNombre      String                   @map("cliente_nombre")
  clienteRuc         String                   @map("cliente_ruc")
  contactoNombre     String?                  @map("contacto_nombre")
  contactoTelefono   String?                  @map("contacto_telefono")
  direccionDespacho  String?                  @map("direccion_despacho")
  repComercial       String?                  @map("rep_comercial")
  condicionPago      String?                  @map("condicion_pago")
  productoNombre     String                   @map("producto_nombre")
  cantidadSolicitada Decimal                  @map("cantidad_solicitada") @db.Decimal(14, 4)
  unidadMedida       String                   @default("KG") @map("unidad_medida")
  lotesRequeridos    Int                      @default(1) @map("lotes_requeridos")
  montoTotal         Decimal                  @map("monto_total") @db.Decimal(14, 2)
  fechaPrometida     DateTime                 @map("fecha_prometida")
  prioridad          PrioridadPedidoComercial @default(NORMAL)
  estado             EstadoPedidoComercial    @default(NUEVO)
  formulaId          String?                  @map("formula_id")
  formula            FormulaMaster?           @relation(fields: [formulaId], references: [id])
  notasAdmin         String?                  @map("notas_admin")
  motivoDevolucion   String?                  @map("motivo_devolucion")

  // Campos nuevos (opcionales para compatibilidad con payloads antiguos)
  docType            String?                  @default("OP") @map("doc_type")   // "COT" | "OP"
  tipoComprobante    String?                  @map("tipo_comprobante")          // "BOLETA" | "FACTURA" | "NOTA_VENTA" (emitido)
  aroma              String?
  color              String?
  aromaText          String?                  @map("aroma_text")
  colorText          String?                  @map("color_text")
  varianteId         String?                  @map("variante_id")
  variante           FormulaVariant?          @relation(fields: [varianteId], references: [id])
  clienteId          String?                  @map("cliente_id")
  clienteRef         Cliente?                 @relation(fields: [clienteId], references: [id])

  aditivos           PedidoAditivo[]
  ordenesProduccion  OrdenProduccion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado])
  @@index([clienteRuc])
  @@index([docType])
  @@map("pedidos_comerciales")
}

model PedidoAditivo {
  id               String          @id @default(uuid())
  pedidoId         String          @map("pedido_id")
  pedido           PedidoComercial @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  insumoId         String          @map("insumo_id")
  insumo           Insumo          @relation(fields: [insumoId], references: [id])
  tipo             TipoInsumo
  porcentaje       Decimal         @default(1.00) @db.Decimal(5, 2)
  gramosCalculados Decimal?        @map("gramos_calculados") @db.Decimal(14, 4)

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([pedidoId])
  @@index([insumoId])
  @@index([tipo])
  @@map("pedido_aditivos")
}

// ============================================================================
// 🟤 MODULO CLIENTES COMERCIALES
// ============================================================================

model Cliente {
  id            String   @id @default(uuid())
  razonSocial   String
  ruc           String   @unique
  telefono      String?
  direccion     String?
  contacto      String?
  metodoEnvio   String?
  condicionPago String?  @default("Contado")

  contactos    ContactoRepresentante[]
  pedidos      PedidoComercial[]
  variantes    FormulaVariant[]
  cuentasCobrar CuentaCobrar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruc])
  @@map("clientes")
}

model ContactoRepresentante {
  id          String   @id @default(uuid())
  clienteId   String   @map("cliente_id")
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nombre      String
  cargo       String?  // Dueño, Compras, Asistente, Recepción, Supervisión
  telefono    String?
  email       String?
  esPrincipal Boolean  @default(false) @map("es_principal")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([clienteId])
  @@map("contacto_representantes")
}

model FormulaVariant {
  id            String        @id @default(uuid())
  nombre        String
  formulaId     String        @map("formula_id")
  formula       FormulaMaster @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  clienteId     String?       @map("cliente_id")
  cliente       Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  nombreMarca   String?       @map("nombre_marca")
  aroma         String?
  color         String?
  phObjetivo    Float?        @map("ph_objetivo")
  viscosidad    String?
  instrucciones   String?
  notas           String?
  ajustesJson     Json?               @map("ajustes_json")
  pasosElaboracion Json?              @map("pasos_elaboracion")

  pedidos PedidoComercial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formulaId])
  @@index([clienteId])
  @@map("formula_variants")
}

model Proveedor {
  id              String   @id @default(uuid())
  ruc             String   @unique
  razonSocial     String   @map("razon_social")
  contacto        String?
  telefono        String?
  correo          String?
  direccion       String?
  insumoPrincipal String?  @map("insumo_principal")
  calificacion    Float    @default(5.0)
  estado          String   @default("HOMOLOGADO")

  cuentasBancarias CuentaBancariaProveedor[]
  cotizaciones     CotizacionProveedor[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("proveedores")
}

model CuentaBancariaProveedor {
  id           String    @id @default(uuid())
  proveedorId  String    @map("proveedor_id")
  proveedor    Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  banco        String
  moneda       String    @default("SOLES")
  numeroCuenta String    @map("numero_cuenta")
  cci          String?

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([proveedorId])
  @@map("cuentas_bancarias_proveedores")
}

model CotizacionProveedor {
  id                  String    @id @default(uuid())
  proveedorId         String    @map("proveedor_id")
  proveedor           Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  insumoId            String    @map("insumo_id")
  insumo              Insumo    @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  precioUnitario      Decimal   @db.Decimal(14, 4) @map("precio_unitario")
  moneda              String    @default("SOLES")
  unidadMedida        String    @default("KG") @map("unidad_medida")
  numCotizacion       String?   @map("num_cotizacion")
  fechaCotizacion     DateTime  @default(now()) @map("fecha_cotizacion")
  variacionPorcentual Decimal?  @db.Decimal(8, 2) @map("variacion_porcentual")
  observaciones       String?
  estado              String    @default("VIGENTE")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([proveedorId])
  @@index([insumoId])
  @@index([fechaCotizacion])
  @@map("cotizaciones_proveedores")
}

model CuentaCobrar {
  id               String      @id @default(uuid())
  codigoDoc        String      @unique @map("codigo_doc")
  clienteId        String?     @map("cliente_id")
  cliente          Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  clienteNombre    String      @map("cliente_nombre")
  clienteRuc       String      @map("cliente_ruc")
  pedidoId         String?     @map("pedido_id")
  ordenProd        String?     @map("orden_prod")
  producto         String?
  montoTotal       Decimal     @db.Decimal(14, 2) @map("monto_total")
  saldoPendiente   Decimal     @db.Decimal(14, 2) @map("saldo_pendiente")
  condicionPago    String      @default("Contado") @map("condicion_pago")
  diasPlazo        Int         @default(0) @map("dias_plazo")
  fechaEmision     DateTime    @default(now()) @map("fecha_emision")
  fechaVencimiento DateTime    @map("fecha_vencimiento")
  fechaPago        DateTime?   @map("fecha_pago")
  estado           String      @default("PENDIENTE") // PAGADO, PENDIENTE, VENCIDO
  medioPago        String?     @map("medio_pago")
  canalBanco       String?     @map("canal_banco")

  pagos            PagoAbono[]

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([clienteRuc])
  @@index([estado])
  @@index([fechaVencimiento])
  @@map("cuentas_cobrar")
}

model PagoAbono {
  id             String       @id @default(uuid())
  cuentaCobrarId String       @map("cuenta_cobrar_id")
  cuentaCobrar   CuentaCobrar @relation(fields: [cuentaCobrarId], references: [id], onDelete: Cascade)
  montoAbonado   Decimal      @db.Decimal(14, 2) @map("monto_abonado")
  fechaAbono     DateTime     @default(now()) @map("fecha_abono")
  medio          String?
  banco          String?
  numOperacion   String?      @map("num_operacion")
  observaciones  String?

  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([cuentaCobrarId])
  @@map("pagos_abonos")
}



