# ============================================================
# QUIMICORP - Worker de Biometría (una copia por sucursal)
# Copia este archivo a `.env` y completa los valores.
# ============================================================

# IP fija del huellero (obligatoria)
ZK_IP=192.168.18.50

# Puerto de comunicación del dispositivo ZKTeco (protocolo ZK)
ZK_PORT=4370

# Password de comunicación del dispositivo (normalmente 0)
ZK_PASSWORD=0

# Base del ERP (ajusta cuando despliegues en la nube)
API_URL=http://localhost:3001/api/v1

# Token de servicio (debe coincidir con ASISTENCIA_SERVICE_TOKEN del backend)
SERVICE_TOKEN=quimicorp-dev-service-token

# Segundos entre lecturas completas de respaldo
POLL_INTERVAL=300

# (Opcional) Forzar serial del dispositivo; si se omite se autodetecta.
# DEVICE_ID=

# (Opcional) Ruta del archivo de deduplicación
# SEEN_FILE=/data/seen.json
