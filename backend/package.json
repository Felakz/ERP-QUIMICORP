    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.30.0",
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.3",
